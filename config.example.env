# Copy to /root/ppflight-cloudinit.env and customize as needed.
# Use it with: sudo bash tools/build-template-engine.sh --config /root/ppflight-cloudinit.env

# Internal engine configuration: PVE storage ID for OS and Cloud-Init disks.
# On an SSD + RAID host, use the RAID storage ID here (for example raid-zfs).
IMAGE_STORAGE=
# File storage that already allows both iso and snippets. The default cache is
# placed below its ISO content directory.
FILE_STORAGE=local
# Optional direct-builder backup storage. It must allow backup content.
# Agent calls use explicit --backup-policy instead of inferring from emptiness.
BACKUP_STORAGE=
# Optional absolute override, for example /mnt/download-ssd/cloud-images-cache
# CACHE_DIR=/mnt/download-ssd/cloud-images-cache
BRIDGE=vmbr0

DISK_SIZE=16G
MEMORY_MB=2048
CORES=2
CPU_TYPE=host
BALLOON=0
FIREWALL=1
# 1 for SSD/NVMe-backed pools; use 0 for a pure HDD RAID pool.
DISK_SSD=1
TIMEZONE=UTC

# Fallback DNS; WHMCS/PVE can override it per clone. Set empty to disable.
DNS_SERVERS="1.1.1.1 8.8.8.8"

# 1 allows root password authentication configured through Cloud-Init.
# Set to 0 for SSH-key-only root login.
ALLOW_ROOT_PASSWORD_SSH=1

ENABLE_QOS=1
QOS_MBPS_RD=200
QOS_MBPS_WR=150
QOS_MBPS_RD_MAX=350
QOS_MBPS_WR_MAX=300
QOS_IOPS_RD=5000
QOS_IOPS_WR=3500
QOS_IOPS_RD_MAX=8000
QOS_IOPS_WR_MAX=6000
QOS_IOPS_RD_MAX_LENGTH=30
QOS_IOPS_WR_MAX_LENGTH=30

# Existing templates are never replaced unless this is 1 or --replace is used.
REPLACE_EXISTING=0
# Also permit replacing an untagged, same-name legacy template. Keep 0 normally.
FORCE_REPLACE_UNMANAGED=0

# all, a comma-separated VMID list, or names such as ubuntu-2204,debian-12
ONLY_TEMPLATES=all
